# --- Service ---
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api

# --- Security (MUST be changed in production) ---
SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Database ---
# SQLite for local dev; PostgreSQL for production.
DATABASE_URL=sqlite:///./swarm.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/swarm
AUTO_CREATE_TABLES=true
DB_ECHO=false

# --- ROS 2 ---
ROS_ENABLED=true
ROS_DOMAIN_ID=0
MAP_TOPIC=/map
AUTOSTART_ROBOT_CONTROLLERS=true
REGISTRATION_TOPIC=/robot/register

# --- Navigation ---
NAV_GOAL_TIMEOUT_SECONDS=300
MAX_TASK_REPEATS=1000
