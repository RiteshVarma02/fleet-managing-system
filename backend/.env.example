ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api

# ---- auth -----------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_MINUTES=720
BOOTSTRAP_DEVELOPER_USERNAME=developer
BOOTSTRAP_DEVELOPER_PASSWORD=change-me-developer
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_OPERATOR_USERNAME=operator
BOOTSTRAP_OPERATOR_PASSWORD=change-me-operator
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- database -------------------------------------------------------------
# MONGO_MODE=local uses MONGO_URI as-is; atlas expects an mongodb+srv URI.
MONGO_MODE=local
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fleet_management
MONGO_MAX_POOL_SIZE=50

# ---- ROS 2 ----------------------------------------------------------------
ROS_ENABLED=true
# V1: the server and EVERY robot share this one domain (robots use /{robot}/...)
ROS_DOMAIN_ID=0
AUTOSTART_ROBOT_CONTROLLERS=true
# All topic names/types live in this one file (see the comments inside it).
FLEET_TOPICS_FILE=config/fleet_topics.yaml

# ---- telemetry write-behind ----------------------------------------------
# High-rate ROS callbacks are buffered in memory; these control how often the
# buffer is bulk-written to Mongo and broadcast to WebSocket clients.
TELEMETRY_FLUSH_INTERVAL_SECONDS=2.0
TELEMETRY_WS_INTERVAL_SECONDS=0.5

# ---- tasks ----------------------------------------------------------------
NAV_GOAL_TIMEOUT_SECONDS=300
# Ignore a final_goal_reached TRUE this soon after a new goal (stale message).
WAYPOINT_ARRIVAL_DEBOUNCE_SECONDS=1.5
MAX_TASK_REPEATS=1000
