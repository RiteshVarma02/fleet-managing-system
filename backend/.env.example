ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api

JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=password
BOOTSTRAP_OPERATOR_USERNAME=operator
BOOTSTRAP_OPERATOR_PASSWORD=operator123
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

MONGO_MODE=local
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fleet_management

ROS_ENABLED=true
ROS_DOMAIN_ID=0
MAP_TOPIC=/map
AUTOSTART_ROBOT_CONTROLLERS=true
REGISTRATION_TOPIC=/robot/register

NAV_GOAL_TIMEOUT_SECONDS=300
MAX_TASK_REPEATS=1000