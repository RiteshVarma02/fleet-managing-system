ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api

# ---- auth -----------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_MINUTES=720
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_OPERATOR_USERNAME=operator
BOOTSTRAP_OPERATOR_PASSWORD=change-me-operator
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- database -------------------------------------------------------------
# MONGO_MODE=local uses MONGO_URI as-is; atlas expects an mongodb+srv URI.
MONGO_MODE=local
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fleet_management
MONGO_MAX_POOL_SIZE=50

# ---- ROS 2 ----------------------------------------------------------------
ROS_ENABLED=true
ROS_DOMAIN_ID=0
MAP_TOPIC=/map
AUTOSTART_ROBOT_CONTROLLERS=true
REGISTRATION_TOPIC=/robot/register

# ---- telemetry write-behind ----------------------------------------------
# High-rate ROS callbacks are buffered in memory; these control how often the
# buffer is bulk-written to Mongo and broadcast to WebSocket clients.
TELEMETRY_FLUSH_INTERVAL_SECONDS=2.0
TELEMETRY_WS_INTERVAL_SECONDS=0.5

# ---- domain bridge --------------------------------------------------------
# Each robot runs on its own ROS_DOMAIN_ID; one bridge process per robot moves
# the topics declared in app/ros/topics_registry.py to the server domain.
DOMAIN_BRIDGE_ENABLED=true
DOMAIN_BRIDGE_DEFAULT_ROBOT_DOMAIN=2
DOMAIN_BRIDGE_RESTART_BACKOFF_SECONDS=5.0
DOMAIN_BRIDGE_MAX_RESTARTS=10

# ---- tasks ----------------------------------------------------------------
NAV_GOAL_TIMEOUT_SECONDS=300
MAX_TASK_REPEATS=1000
